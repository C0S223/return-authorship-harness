{
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "350000",
    "PYTHONUTF8": "1"
  },
  "permissions": {
    "deny": [
      "RemoteTrigger",
      "mcp__claude-code-remote__send_later",
      "mcp__claude-code-remote__watch_url",
      "mcp__claude-code-remote__update_trigger",
      "mcp__Claude_Code_Remote__send_later",
      "mcp__Claude_Code_Remote__watch_url",
      "mcp__Claude_Code_Remote__update_trigger",
      "mcp__claude-in-chrome__javascript_tool",
      "mcp__Claude_Browser__javascript_tool",
      "mcp__Claude_Browser__browser_batch",
      "mcp__claude-in-chrome__browser_batch",
      "Bash(claude plugin:*)",
      "Agent(general-purpose)",
      "Workflow",
      "Edit(/.claude/**)",
      "Edit(/.codex/**)",
      "Edit(/.agents/**)",
      "Edit(/.githooks/**)",
      "Edit(/.github/**)",
      "Edit(/roles/**)",
      "Edit(/graphs/**)",
      "Edit(**/CLAUDE.md)",
      "Edit(**/AGENTS.md)",
      "Edit(**/AGENTS.override.md)",
      "Edit(/README.md)",
      "Edit(/.git/config)",
      "Edit(/.git/hooks/**)"
    ],
    "ask": [
      "CronCreate",
      "mcp__scheduled-tasks__create_scheduled_task",
      "mcp__scheduled-tasks__update_scheduled_task",
      "mcp__scheduled-tasks__run_scheduled_task",
      "mcp__claude-code-remote__create_trigger",
      "mcp__Claude_Code_Remote__create_trigger",
      "mcp__claude-code-remote__create_session",
      "mcp__Claude_Code_Remote__create_session"
    ],
    "blockWritesOutsideWorkingDirectories": true
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowWrite": [
        "../../.git"
      ],
      "denyWrite": [
        "./.claude",
        "./.codex",
        "./.agents",
        "./.githooks",
        "./.github",
        "./roles",
        "./graphs",
        "./CLAUDE.md",
        "./AGENTS.md",
        "./README.md",
        "./.git/config",
        "./.git/hooks",
        "../../.git/config",
        "../../.git/hooks",
        "~/.claude/settings.json",
        "~/.codex",
        "./AGENTS.override.md"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "pypi.org",
        "files.pythonhosted.org",
        "registry.npmjs.org"
      ],
      "allowLocalBinding": true
    },
    "enableWeakerNetworkIsolation": true
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/auto-compact/check.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/auto-compact/resume.sh\"; [ -f \"$f\" ] || { echo \"Safety check file missing: $f. If this folder was moved or renamed, restart Claude Code from it; otherwise restore the file with git.\" >&2; exit 2; }; bash \"$f\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
